---
const mailIcon = 'src/assets/mail-fill.svg';
const githubIcon = 'src/assets/github-fill.svg';

const currentYear = new Date().getFullYear();

const description = "An archive of interwar history.";

interface Links {
  title: string;
  url: string;
}

const internalLinks: Links[] = [
  {
    title: 'About',
    url: '/about',
  },
  {
    title: 'Donate',
    url: '/donate',
  },
  {
    title: 'Feeds',
    url: '/feeds',
  },
  {
    title: 'Privacy',
    url: '/privacy',
  },
]

const externalLinks: Links[] = [
  {
    title:'Email',
    url:'mailto:',
  },
  /*
    {
      title: 'Patreon',
      url:'https://patreon.com',
    },
    {
      title: 'X',
      url:'https://x.com',
    },
  */
  {
    title: 'Github',
    url:'https://github.com/OpkarGhadu/interwar.org',
  },
];

---
<footer>
  <hr/>
  <div class="footer-content">
    <div class="footer-menu">
      <div class="footer-box">
        <a 
        class="footer-link-item" 
        href="https://interwar.org">
          {/* <span>[Logo]</span>*/}
          <span>Interwar.org</span>
        </a>
        <p>{description}</p>
        <div>
          <nav>
          <ul class="footer-link-list">
            {externalLinks.map((link) => (
              <li>
                <a 
                class="footer-link-item" 
                href={link.url}>
                  {link.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        </div>
      </div>
      <div class="footer-box">
        <p class="footer-box-title">Information</p>
        <nav>
          <ul class="footer-link-list">
            {internalLinks.map((link) => (
              <li>
                <a 
                class="footer-link-item" 
                href={link.url}>{link.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
      <div class="footer-box">
        <p class="footer-box-title">Links</p>
        
      </div>
    </div>
    <div class="footer-copyright">
      <p class="copyright">&copy; {currentYear} Interwar.org</p>
    </div>
  </div>
</footer>

<style>
  .footer-content {
    font-size: 1em;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  .footer-menu {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .footer-information {
  }
  .footer-box {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }
  .footer-box-title{
    font-size: 1rem;
    font-weight: bold;
  }
  .footer-copyright {
    margin-top: 1rem;
    text-align: center;
  }
  .copyright{
    font-size: 1rem;
  }
  .footer-link-list {
    list-style: none;
    display: flex;
    flex-direction: row;
    gap: 1rem;
  }
  .footer-link-item {
    font-size: 1rem;
  }


  /* Screen width above 768px - Tablets, Laptops, Desktops */
  @media screen and (min-width: 768px) {
    .footer-menu {
      flex-direction: row;
      justify-content: space-between;
    }
    .footer-link-list {
      flex-direction: column;
      gap: 0rem;
    }
  }
</style>