---
import type { Record } from "../types/Record";

interface Props {
  records: Record[];
}

const { records } = Astro.props;
/*
const categories = [
  { type: "photograph", title: "Photographs" },
  { type: "book", title: "Books" },
  { type: "broadcast", title: "Broadcasts" },
  { type: "article", title: "Articles" },
  { type: "letter", title: "Letters" },
  { type: "speech", title: "Speeches" },
  { type: "interview", title: "Interviews" },
  { type: "diary", title: "Diaries" },
  { type: "document", title: "Documents" },
  { type: "anecdote", title: "Anecdotes" },
];*/

const categories = [
  { type: "image", title: "Images" },
  { type: "audio", title: "Audio" },
  { type: "text", title: "Texts" },
  { type: "video", title: "Videos" },
];

const groupedRecords = categories
  .map((category) => ({
    ...category,
    records: records
      .filter((record) => record.MediaFormat === category.type)
      .sort((a, b) => {
        const dateA = a.Date || a.DateAdded;
        const dateB = b.Date || b.DateAdded;
        return dateB.localeCompare(dateA);
      }),
  }))
  .filter((category) => category.records.length > 0);

// const mediaURL = "https://media.interwar.org";
// console.log("Records: ", records);


---


{groupedRecords.length > 0 && (
  <section class="records">
    <h2>Records</h2>

    <nav>
      {groupedRecords.map((category) => (
        <a href={`#${category.type}`}>{category.title}</a>
      ))}
    </nav>

    {groupedRecords.map((category) => (
      <section id={category.type}>
        <h3>{category.title}</h3>

        <ul>
          {category.records.map((record) => (
            <li>
              <a href={`/records/${record.Slug}`}>
                {record.DocumentTitle}
              </a>
              {record.Date && <span> — {record.Date}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
)}

<style>
nav {
  display: flex;
  flex-direction: row;
  gap: 1rem;
}
.records img {
  display: block;
  max-height: 300px;
  max-width: 100%;
  width: auto;
  object-fit: contain;
  margin-bottom: 1rem;
}
</style>