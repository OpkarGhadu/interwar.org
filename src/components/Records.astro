---
import type { Record } from "../types/Record";

interface Props {
  records: Record[];
}

const { records } = Astro.props;

const categories = [
  { type: "photograph", title: "Photographs" },
  { type: "book", title: "Books" },
  { type: "broadcast", title: "Broadcasts" },
  { type: "article", title: "Articles" },
  { type: "letter", title: "Letters" },
  { type: "speech", title: "Speeches" },
  { type: "interview", title: "Interviews" },
  { type: "diary", title: "Diaries" },
  { type: "document", title: "Documents" },
  { type: "anecdote", title: "Anecdotes" },
];

const groupedRecords = categories
  .map((category) => ({
    ...category,
    records: records
      .filter((record) => record.RecordType === category.type)
      .sort((a, b) => {
        const dateA = a.Date || a.DateAdded;
        const dateB = b.Date || b.DateAdded;
        return dateB.localeCompare(dateA);
      }),
  }))
  .filter((category) => category.records.length > 0);

const mediaURL = "https://media.interwar.org";
// console.log("Records: ", records);

/* 
To Do:
- 4 categories of records: audio, image, text, video
- 
*/
---

{groupedRecords.length > 0 && (

  <section class="records">     <h2>Records</h2>

{groupedRecords.map((category) => (
  <section>
    <h3>{category.title}</h3>

    {category.records.map((record) => (
      <article>
        {record.StorageKey && record.MediaFormat === "image" && (
          <img
            src={`${mediaURL}/${record.StorageKey}`}
            alt={record.Abstract || "Photograph"}
            loading="lazy"
          />
        )}

        {record.StorageKey && record.MediaFormat === "audio" && (
          <audio controls preload="none">
            <source src={`${mediaURL}/${record.StorageKey}`} />
          </audio>
        )}

        {record.StorageKey && record.MediaFormat === "video" && (
          <video controls preload="metadata">
            <source src={`${mediaURL}/${record.StorageKey}`} />
          </video>
        )}

        <h4>{record.DocumentTitle}</h4>

        {record.Abstract && <p>{record.Abstract}</p>}
      </article>
    ))}
  </section>
))}

</section> )}

<style>
.records img {
  display: block;
  max-height: 300px;
  max-width: 100%;
  width: auto;
  object-fit: contain;
  margin-bottom: 1rem;
}
</style>