---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllPeople } from "../../lib/db/people";
import { getRecordsForPerson } from "../../lib/db/records";

import Quote from "../../components/Quote.astro";
import Details from "../../components/Details.astro";
import Biography from "../../components/Biography.astro";
import Records from "../../components/Records.astro";
import Credits from "../../components/Credits.astro";

export async function getStaticPaths() {
  const people = await getAllPeople();

  return people.map((person) => ({
    params: {
      PersonId: person.PersonId,
    },
    props: {
      person,
    },
  }));
};

const { person } = Astro.props;
const records = await getRecordsForPerson(person.PersonId);
---

<BaseLayout
  pageTitle={person.Name}
  description={person.Abstract || person.Name}
>
  <article class="person-page">

    <header class="person-header">
      <h1>{person.Name}</h1>
    </header>

    <Quote
      quote={person.Quote}
      source={person.QuoteSource}
      author={person.Name}
    />

    <Details
      aliases={person.Aliases}
      wikidataId={person.WikidataId}
      birthDate={person.BirthDate}
      deathDate={person.DeathDate}
      abstract={person.Abstract}
    />

    <Biography
      biography={person.Biography}
    />
    
    <Records
      records={records}
    />
    
    <Credits
      dateAdded={person.DateAdded}
      dateUpdated={person.DateUpdated}
    />

  </article>
</BaseLayout>

<style>
.person-page {
  max-width: 900px;
  margin-inline: auto;
}

.person-header{
  margin-bottom: 2rem;
  padding-bottom: 1rem;
}

</style>


