---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllPeople } from "../../lib/db/people";

import Quote from "../../components/Quote.astro";
import Details from "../../components/Details.astro";
import Biography from "../../components/Biography.astro";
import Credits from "../../components/Credits.astro";

export async function getStaticPaths() {
  const people = await getAllPeople();

  return people.map((person) => ({
    params: {
      PersonId: person.PersonId,
    },
    props: {
      person,
    },
  }));
}

/* 
export type Person = {
  --PersonId: string;
  ++Name: string;
  --SortName: string;
  ##Aliases: string | null;
  ##WikidataId: string | null;
  ##BirthDate: string | null;
  ##DeathDate: string | null;
  Biography: string | null;
  ##Abstract: string | null;
  __Quote: string | null;
  __QuoteSource: string | null;
  LastUpdated: string;
};

*/

const { person } = Astro.props;
---

<BaseLayout
  pageTitle={person.Name}
  description={person.Abstract || person.Name}
>
  <article>
    <h1>{person.Name}</h1>

    <Quote
      quote={person.Quote}
      source={person.QuoteSource}
      author={person.Name}
    />

    <Details
      aliases={person.Aliases}
      wikidataId={person.WikidataId}
      birthDate={person.BirthDate}
      deathDate={person.DeathDate}
      abstract={person.Abstract}
    />

    <Biography

    />
    
    <p>Content</p>
    <ul>
      <li>Photos</li>
      <li>Broadcasts</li>
      <li>Writings</li>
      <li>Books</li>
    </ul>
    
    <Credits
      lastUpdated={person.LastUpdated}
    />

  </article>
</BaseLayout>

