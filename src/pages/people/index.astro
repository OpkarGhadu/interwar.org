---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPeopleIndex } from "../../lib/db/people";
const name = "People";
const description = "People";

const peopleIndex = await getPeopleIndex();
---

<BaseLayout pageTitle={name} description={description}>
  <div>
    <h1>People</h1>
    <ul>
      {peopleIndex.map((person) => (
        <li>
          <a href={`/people/${person.Slug}/`}>{person.Name}</a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
