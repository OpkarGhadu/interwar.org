---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllContributors } from "../../lib/db/contributors";
const name = "Contributors";
const description = "All Contributors";

const allContributors = await getAllContributors();
---

<BaseLayout pageTitle={name} description={description}>
  <div>
    <h1>Contributors</h1>
    <ul>
      {
        allContributors.map((contributor) => (
          <li>
            <a href={`/contributors/${contributor.Slug}/`}>
              {contributor.Name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
