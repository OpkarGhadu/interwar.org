---
import BaseLayout  from "../layouts/BaseLayout.astro";
const name = "Donate";
const description = "Donate to Interwar";

interface Link {
  title: string;
  url: string;
}

const DonationLinks: Link[] = [
 {
	title: "Github Sponsors",
	url: "https://github.com/sponsors/OpkarGhadu"
 }
]
---

<BaseLayout 
	pageTitle={name}
	description={description}
>
	<div>
		<h1>{name}</h1>
		<ul>
			{DonationLinks.map((link) => (
				<li><a href={link.url}>{link.title}</a></li>
			))}
		</ul>
	</div>

</BaseLayout>